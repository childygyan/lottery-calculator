---
/**
 * Base layout: head metadata, header, footer.
 * Every page passes a PageMeta built with buildPageMeta().
 */
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import type { PageMeta } from "../lib/seo/metadata.ts";
import { siteUrl } from "../data/site.ts";

/** Legacy staging hostname — visitors here are sent to the production domain. */
const LEGACY_HOST = "lottery-calculator.childygyan.workers.dev";

/** Google Analytics 4 measurement ID. Fires on the production domain only. */
const GA_ID = "G-HEF85ZBF99";
const PROD_HOST = new URL(siteUrl).hostname;

interface Props {
  meta: PageMeta;
  /** JSON-LD strings rendered as application/ld+json scripts. */
  jsonLd?: string[];
}

const { meta, jsonLd = [] } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={meta.canonical} />
    <meta name="robots" content={meta.robots} />
    <meta property="og:type" content={meta.ogType} />
    <meta property="og:site_name" content={meta.siteName} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={meta.canonical} />
    <meta property="og:image" content={meta.ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={meta.ogImage} />
    <meta name="theme-color" content="#1d4ed8" />
    <meta name="google-site-verification" content="s2ccM6JUwChvS3CW0v_8vFprHIRqZvqXEGPKBkITMKo" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-HEF85ZBF99"></script>
    <script define:vars={{ GA_ID, PROD_HOST }}>
      // Google Analytics 4 — production domain only, so staging/test traffic
      // never pollutes the numbers.
      if (window.location.hostname === PROD_HOST) {
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () {
          window.dataLayer.push(arguments);
        };
        window.gtag("js", new Date());
        window.gtag("config", GA_ID);
      }
    </script>
    <script define:vars={{ siteUrl, LEGACY_HOST }}>
      // Immediate redirect off the legacy workers.dev staging hostname.
      // (The permanent 301 lives in the Worker itself — see docs/WORKER-REDIRECT.md.)
      if (window.location.hostname === LEGACY_HOST) {
        window.location.replace(
          siteUrl + window.location.pathname + window.location.search + window.location.hash,
        );
      }
    </script>
    {jsonLd.map((json) => <script type="application/ld+json" set:html={json} />)}
  </head>
  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:font-semibold focus:text-blue-800 focus:shadow"
    >
      Skip to content
    </a>
    <Header />
    <main id="main-content" class="mx-auto w-full max-w-6xl px-4 sm:px-6">
      <slot />
    </main>
    <Footer />
  </body>
</html>
