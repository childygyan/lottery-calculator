---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { buildPageMeta } from "../lib/seo/metadata.ts";
import { siteName, contactEmail } from "../data/site.ts";

const meta = buildPageMeta({
  title: `Privacy Policy — ${siteName}`,
  description: `How ${siteName} handles your information: no accounts, calculator inputs stay in your browser, and what our planned analytics will (and won't) collect.`,
  path: "/privacy/",
  robots: "index, follow",
});
---

<Layout meta={meta}>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <Breadcrumbs items={[{ name: "Home", href: "/" }, { name: "Privacy Policy" }]} />
    <article class="max-w-3xl">
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Privacy Policy</h1>
      <p class="mt-2 text-sm text-slate-500">Last updated: September 2026</p>
      <div class="mt-6 space-y-5 text-base leading-relaxed text-slate-600">
        <h2 class="pt-2 text-xl font-bold text-slate-900">Who we are</h2>
        <p>
          {siteName} is operated by Firoz Khan (FK Digital Media). If you have
          questions about this policy, email us at{" "}
          <a href={`mailto:${contactEmail}`} class="font-semibold text-blue-700 hover:underline">
            {contactEmail}
          </a>.
        </p>

        <h2 class="pt-2 text-xl font-bold text-slate-900">Information we collect</h2>
        <p>
          {siteName} does not require accounts. Our calculators run entirely in
          your browser: the numbers you enter (jackpot amounts, cash values,
          state selections) are processed on your own device and are never sent
          to us or to any third party. We do not ask for your name, email
          address, or financial account details to show a calculation.
        </p>
        <p>
          If you email us, we receive only what you choose to include in your
          message, and we use it solely to respond. We do not add you to any
          mailing list.
        </p>

        <h2 class="pt-2 text-xl font-bold text-slate-900">Analytics</h2>
        <p>
          We use Google Analytics 4 (measurement ID{" "}
          <code class="rounded bg-slate-100 px-1 text-sm">G-HEF85ZBF99</code>)
          to understand aggregate site usage — for example, which pages are
          visited most and which calculators people find useful — so we can
          improve the site. Google Analytics may record:
        </p>
        <ul class="list-disc space-y-2 pl-6">
          <li>Pages visited and time spent on the site;</li>
          <li>Device and browser type, screen size, and operating system;</li>
          <li>Approximate location (country or city level, derived from IP address);</li>
          <li>How you arrived (for example, a search engine or referring site).</li>
        </ul>
        <p>
          Analytics will <strong class="font-semibold text-slate-800">not</strong> collect
          the numbers you enter into calculators, will not be used for
          advertising targeting, and will not be sold or shared with data
          brokers. Google processes this aggregate usage data on our behalf;
          see{" "}
          <a
            href="https://policies.google.com/privacy"
            target="_blank"
            rel="noopener noreferrer"
            class="font-semibold text-blue-700 hover:underline"
          >
            Google's Privacy Policy
          </a>{" "}
          for details. You can opt out with the{" "}
          <a
            href="https://tools.google.com/dlpage/gaoptout"
            target="_blank"
            rel="noopener noreferrer"
            class="font-semibold text-blue-700 hover:underline"
          >
            Google Analytics opt-out browser add-on
          </a>.
        </p>

        <h2 class="pt-2 text-xl font-bold text-slate-900">Cookies</h2>
        <p>
          Google Analytics uses cookies (such as{" "}
          <code class="rounded bg-slate-100 px-1 text-sm">_ga</code>) to
          distinguish visits and count usage accurately. You can block cookies
          in your browser settings at any time; the calculators will continue
          to work normally.
        </p>
        <p>We do not use advertising trackers.</p>

        <h2 class="pt-2 text-xl font-bold text-slate-900">Data sharing and retention</h2>
        <p>
          We do not sell your personal information. We share data only with the
          analytics provider described above, and only for operating and
          improving this site. Contact emails are kept only as long as needed
          to handle your message. Because calculator inputs never leave your
          browser, there is nothing of them to retain or delete.
        </p>

        <h2 class="pt-2 text-xl font-bold text-slate-900">Children's privacy</h2>
        <p>
          {siteName} is a general-audience site and is not directed at children
          under 13. We do not knowingly collect personal information from
          children.
        </p>

        <h2 class="pt-2 text-xl font-bold text-slate-900">Changes to this policy</h2>
        <p>
          If we change this policy — for example, when analytics goes live —
          we will update the "Last updated" date above. Continued use of the
          site after changes means you accept the updated policy.
        </p>
      </div>
    </article>
  </div>
</Layout>
