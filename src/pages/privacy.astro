---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { buildPageMeta } from "../lib/seo/metadata.ts";
import { siteName } from "../data/site.ts";

const meta = buildPageMeta({
  title: `Privacy Policy — ${siteName}`,
  description: `How ${siteName} handles your information. We don't require accounts or collect personal data to run calculations.`,
  path: "/privacy/",
  robots: "index, follow",
});
---

<Layout meta={meta}>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <Breadcrumbs items={[{ name: "Home", href: "/" }, { name: "Privacy Policy" }]} />
    <article class="max-w-3xl">
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Privacy Policy</h1>
      <p class="mt-2 text-sm text-slate-500">Last updated: September 2026</p>
      <div class="mt-6 space-y-5 text-base leading-relaxed text-slate-600">
        <h2 class="pt-2 text-xl font-bold text-slate-900">Information we collect</h2>
        <p>
          {siteName} does not require accounts, and our calculators run entirely in your
          browser. We do not ask for your name, email, or financial account details, and the
          numbers you enter into a calculator are never sent to us.
        </p>
        <h2 class="pt-2 text-xl font-bold text-slate-900">Analytics and cookies</h2>
        <p>
          We may use privacy-respecting analytics to understand aggregate site usage (such as
          which pages are visited). We do not use advertising trackers.
        </p>
        <h2 class="pt-2 text-xl font-bold text-slate-900">Contact</h2>
        <p>
          If you email us, we receive only what you choose to include in your message, and we
          use it solely to respond.
        </p>
      </div>
    </article>
  </div>
</Layout>
