---
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { buildPageMeta } from "../lib/seo/metadata.ts";
import { siteName } from "../data/site.ts";

const meta = buildPageMeta({
  title: `About — ${siteName}`,
  description:
    "Learn what Lottery Calculator is, how its estimates work, and why every figure is clearly labeled as an estimate.",
  path: "/about/",
});
---

<Layout meta={meta}>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <Breadcrumbs items={[{ name: "Home", href: "/" }, { name: "About" }]} />
    <article class="max-w-3xl">
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">About</h1>
      <div class="mt-6 space-y-5 text-base leading-relaxed text-slate-600">
        <p>
          {siteName} is a free, easy-to-use set of lottery calculators. Our goal is simple:
          help you understand what a lottery win might actually be worth after taxes — before
          anyone tries to sell you something.
        </p>
        <h2 class="pt-2 text-xl font-bold text-slate-900">How our estimates work</h2>
        <p>
          The core calculator takes three inputs — the advertised jackpot, the cash option,
          and your state — and estimates federal income tax using single-filer tax brackets
          plus state tax using a top-marginal-rate planning estimate. Subtracting both from
          the cash option gives an estimated take-home amount and effective tax rate.
        </p>
        <p>
          Every result is labeled as an estimate. We do not promise exact figures, and we do
          not provide tax or financial advice. For decisions involving real winnings, consult
          a qualified tax professional.
        </p>
        <h2 class="pt-2 text-xl font-bold text-slate-900">What we don't do</h2>
        <ul class="list-disc space-y-2 pl-6">
          <li>We don't claim anyone can improve their chances of winning.</li>
          <li>We don't present estimates as exact tax bills.</li>
          <li>We don't collect your personal information to show a calculation.</li>
        </ul>
        <h2 class="pt-2 text-xl font-bold text-slate-900">Behind the site</h2>
        <div class="flex items-center gap-5">
          <img
            src="/firoz-khan.webp"
            alt="Firoz Khan"
            width="96"
            height="96"
            loading="lazy"
            class="h-24 w-24 shrink-0 rounded-full border border-slate-200 object-cover"
          />
          <div>
            <p class="font-semibold text-slate-900">Firoz Khan</p>
            <p class="mt-1 max-w-xl text-sm leading-relaxed text-slate-600">
              Firoz is an independent maker behind FK Digital Media. He builds
              free online tools — Lottery Calculator started from a simple
              idea: understanding a lottery win shouldn't need a finance
              degree, or an email signup. Every calculator on this site runs
              entirely in your browser, shows its assumptions, and labels
              every figure as an estimate.
            </p>
            <p class="mt-2 text-sm font-semibold text-slate-500">
              Find me here:
            </p>
            <ul class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-sm font-semibold">
              <li>
                <a
                  href="https://www.linkedin.com/in/firoz-khan-1153358a/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-blue-700 hover:underline"
                >
                  LinkedIn
                </a>
              </li>
              <li>
                <a
                  href="https://www.instagram.com/rtibyfiroz/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-blue-700 hover:underline"
                >
                  Instagram
                </a>
              </li>
              <li>
                <a
                  href="https://github.com/fkdigitalmedia"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-blue-700 hover:underline"
                >
                  GitHub
                </a>
              </li>
            </ul>
          </div>
        </div>
        <p>
          Questions? Visit our <a href="/contact/" class="font-semibold text-blue-700 hover:underline">contact page</a>.
        </p>
      </div>
    </article>
  </div>
</Layout>
