---
import Layout from "../layouts/Layout.astro";
import { buildPageMeta } from "../lib/seo/metadata.ts";
import { siteName } from "../data/site.ts";

const meta = buildPageMeta({
  title: `Page not found — ${siteName}`,
  description: "The page you were looking for doesn't exist.",
  path: "/404/",
  robots: "noindex, follow",
});
---

<Layout meta={meta}>
  <div class="mx-auto max-w-6xl px-4 py-16 text-center sm:px-6 sm:py-24">
    <p class="text-6xl font-bold tracking-tight text-slate-900">404</p>
    <h1 class="mt-4 text-2xl font-bold text-slate-900">Page not found.</h1>
    <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-slate-600">
      The page you're looking for doesn't exist or was moved. Let's get you back to the
      calculators.
    </p>
    <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
      <a href="/" class="btn-secondary">Go Home</a>
      <a href="/lottery-calculator/" class="btn-primary">Lottery Calculator</a>
    </div>
  </div>
</Layout>
