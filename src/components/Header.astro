---
import { mainNav } from "../data/navigation.ts";
import { siteName } from "../data/site.ts";

const currentPath = Astro.url.pathname;
---

<header class="border-b border-slate-200 bg-white">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <a href="/" class="flex items-center gap-2.5" aria-label={`${siteName} — home`}>
      <svg width="32" height="32" viewBox="0 0 64 64" aria-hidden="true" class="shrink-0">
        <rect width="64" height="64" rx="14" fill="#1d4ed8"></rect>
        <text x="32" y="45" font-family="system-ui, sans-serif" font-size="36" font-weight="700" fill="#ffffff" text-anchor="middle">$</text>
      </svg>
      <span class="text-lg font-bold tracking-tight text-slate-900">{siteName}</span>
    </a>

    <nav class="hidden md:block" aria-label="Primary">
      <ul class="flex items-center gap-1">
        {
          mainNav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={currentPath === item.href ? "page" : undefined}
                class:list={[
                  "rounded-lg px-4 py-2.5 text-sm font-semibold transition-colors",
                  currentPath === item.href
                    ? "bg-blue-50 text-blue-800"
                    : "text-slate-700 hover:bg-slate-100 hover:text-slate-900",
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      type="button"
      id="menu-button"
      class="btn-secondary !px-4 !py-2 text-sm md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      Menu
    </button>
  </div>

  <nav id="mobile-menu" class="hidden border-t border-slate-200 bg-white md:hidden" aria-label="Mobile">
    <ul class="space-y-1 px-4 py-3">
      {
        mainNav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={currentPath === item.href ? "page" : undefined}
              class:list={[
                "block rounded-lg px-4 py-3 text-base font-semibold",
                currentPath === item.href ? "bg-blue-50 text-blue-800" : "text-slate-700 hover:bg-slate-100",
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  // Minimal progressive-enhancement toggle for the mobile menu.
  const menuButton = document.getElementById("menu-button");
  const mobileMenu = document.getElementById("mobile-menu");
  menuButton?.addEventListener("click", () => {
    if (!mobileMenu || !menuButton) return;
    mobileMenu.classList.toggle("hidden");
    menuButton.setAttribute("aria-expanded", String(!mobileMenu.classList.contains("hidden")));
  });
</script>
