---
/**
 * Prize tier table for a lottery game.
 *
 * A single semantic <table> (proper <th> scope, caption) wrapped in a
 * horizontal scroll container on small screens — one markup source instead of
 * a duplicated desktop table + mobile card list, which halves the HTML and
 * gives screen readers one consistent structure. Games with a built-in
 * multiplier (Mega Millions) render per-multiplier columns; others render
 * the fixed base prize.
 */
import { formatOdds, type LotteryConfig } from "../data/lotteries/index.ts";

interface Props {
  config: LotteryConfig;
  headingId?: string;
}

const { config, headingId = "prize-tiers-heading" } = Astro.props;

const multiplierTiers = config.prizeTiers.some((t) => t.prizeByMultiplier);
const multiplierKeys = config.multiplier?.multipliers.map(String) ?? [];

function prizeLabel(tier: (typeof config.prizeTiers)[number]): string {
  if (tier.basePrize === "jackpot") return "Jackpot";
  return tier.basePrize.toLocaleString("en-US", {
    style: "currency",
    currency: "USD",
    maximumFractionDigits: 0,
  });
}

function multiplierPrize(tier: (typeof config.prizeTiers)[number], key: string): string {
  const prize = tier.prizeByMultiplier?.[key];
  if (prize === undefined) return "—";
  return prize.toLocaleString("en-US", {
    style: "currency",
    currency: "USD",
    maximumFractionDigits: 0,
  });
}
---

<section aria-labelledby={headingId} class="mt-14">
  <h2 id={headingId} class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
    {config.name} Prize Tiers
  </h2>
  <p class="mt-3 max-w-3xl text-base leading-relaxed text-slate-600">
    {config.prizeTiers.length} ways to win, from the jackpot down to the
    lowest tier. Odds are per play.
    {multiplierTiers && config.multiplier && (
      <>
        {" "}Non-jackpot prizes shown by {config.multiplier.name} multiplier
        ({config.multiplier.costDescription}).
      </>
    )}
  </p>

  {/* Single responsive table: horizontal scroll on small screens keeps one
      semantic table for sighted users and screen readers alike. */}
  <div class="mt-6 overflow-x-auto rounded-2xl border border-slate-200">
    <table class="w-full min-w-[560px] border-collapse bg-white text-left text-sm">
      <caption class="sr-only">
        {config.name} prize tiers, prizes, and odds
      </caption>
      <thead>
        <tr class="bg-slate-50">
          <th scope="col" class="px-5 py-3 font-semibold text-slate-900">Match</th>
          {multiplierTiers ? (
            multiplierKeys.map((key) => (
              <th scope="col" class="px-5 py-3 font-semibold text-slate-900">{key}X</th>
            ))
          ) : (
            <th scope="col" class="px-5 py-3 font-semibold text-slate-900">Prize</th>
          )}
          <th scope="col" class="px-5 py-3 font-semibold text-slate-900">Odds</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-200">
        {config.prizeTiers.map((tier) => (
          <tr>
            <th scope="row" class="px-5 py-3 font-medium text-slate-900">
              {tier.matchPattern}
            </th>
            {multiplierTiers ? (
              multiplierKeys.map((key) => (
                <td class="px-5 py-3 text-slate-600">{multiplierPrize(tier, key)}</td>
              ))
            ) : (
              <td class="px-5 py-3 text-slate-600">{prizeLabel(tier)}</td>
            )}
            <td class="px-5 py-3 text-slate-600">{formatOdds(tier.odds)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
