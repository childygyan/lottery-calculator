---
import { footerNav } from "../data/navigation.ts";
import { siteName } from "../data/site.ts";

const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-white">
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
      <div class="max-w-sm">
        <p class="text-base font-bold text-slate-900">{siteName}</p>
        <p class="mt-2 text-sm text-slate-600">
          Estimate lottery winnings, taxes, payouts, and take-home amounts with easy-to-use
          calculators. Results are estimates for informational purposes only.
        </p>
      </div>
      <nav aria-label="Footer">
        <ul class="grid grid-cols-2 gap-x-8 gap-y-2 sm:grid-cols-3">
          {
            footerNav.map((item) => (
              <li>
                <a href={item.href} class="text-sm text-slate-600 hover:text-blue-700 hover:underline">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
    <div class="mt-8 border-t border-slate-200 pt-6">
      <p class="text-xs text-slate-500">
        © {year} {siteName}. All calculator results are estimates and do not constitute tax or
        financial advice.
      </p>
    </div>
  </div>
</footer>
