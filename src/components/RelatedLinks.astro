---
/**
 * Reusable contextual internal-link block.
 * Only renders links to pages that exist — pass them in explicitly.
 */
export interface RelatedLink {
  label: string;
  href: string;
  description?: string;
}

interface Props {
  title?: string;
  links: RelatedLink[];
}

const { title = "Related", links } = Astro.props;
---

<nav aria-label={title} class="card !p-6">
  <h2 class="text-lg font-bold text-slate-900">{title}</h2>
  <ul class="mt-4 space-y-3">
    {
      links.map((link) => (
        <li>
          <a href={link.href} class="font-semibold text-blue-700 hover:underline">
            {link.label}
          </a>
          {link.description && <p class="mt-0.5 text-sm text-slate-600">{link.description}</p>}
        </li>
      ))
    }
  </ul>
</nav>
