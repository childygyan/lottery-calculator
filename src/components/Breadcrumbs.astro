---
export interface Crumb {
  name: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mb-6">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm">
    {
      items.map((item, index) => (
        <li class="flex items-center gap-2">
          {index > 0 && (
            <span aria-hidden="true" class="text-slate-400">
              /
            </span>
          )}
          {item.href ? (
            <a href={item.href} class="text-blue-700 hover:underline">
              {item.name}
            </a>
          ) : (
            <span aria-current="page" class="text-slate-500">
              {item.name}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
