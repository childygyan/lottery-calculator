---
/**
 * Source / reference list. Compact by design: each source renders as a
 * linked name plus publisher and last-verified date — a proper citation
 * without repeating multi-sentence descriptions on every page (the full
 * descriptions live on /sources/). Links only render for verified URLs —
 * a source without a confirmed address is named, never given a fake link.
 */
import { SOURCES } from "../data/sources.ts";

interface Props {
  /** Source registry ids, in display order. */
  ids: string[];
  heading?: string;
}

const { ids, heading = "Sources & References" } = Astro.props;
const sources = ids
  .map((id) => SOURCES[id])
  .filter((s) => s !== undefined);
---

<section aria-label={heading} class="mt-14">
  <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
    {heading}
  </h2>
  <ul class="mt-6 space-y-2">
    {sources.map((source) => (
      <li class="rounded-xl border border-slate-200 bg-white px-4 py-3">
        <p class="text-sm text-slate-900">
          {source.url ? (
            <a
              href={source.url}
              target="_blank"
              rel="noopener noreferrer"
              class="font-semibold text-blue-700 hover:underline"
            >
              {source.name}
            </a>
          ) : (
            <span class="font-semibold">{source.name}</span>
          )}
          <span class="text-slate-500">
            {" "}· {source.publisher} · Last verified {source.lastChecked}
          </span>
        </p>
      </li>
    ))}
  </ul>
</section>
