---
export interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  items: FaqItem[];
  heading?: string;
  headingId?: string;
}

const { items, heading = "Frequently Asked Questions", headingId = "faq-heading" } = Astro.props;
---

<section aria-labelledby={headingId} class="mt-14">
  <h2 id={headingId} class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
    {heading}
  </h2>
  <div class="mt-6 divide-y divide-slate-200 rounded-2xl border border-slate-200 bg-white">
    {
      items.map((item) => (
        <details class="group px-5 py-4 sm:px-6">
          <summary class="cursor-pointer list-none text-base font-semibold text-slate-900 marker:hidden [&::-webkit-details-marker]:hidden">
            <span class="flex items-center justify-between gap-4">
              {item.question}
              <svg
                aria-hidden="true"
                class="h-5 w-5 shrink-0 text-slate-400 transition-transform group-open:rotate-180"
                viewBox="0 0 20 20"
                fill="currentColor"
              >
                <path
                  fill-rule="evenodd"
                  d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
                  clip-rule="evenodd"
                />
              </svg>
            </span>
          </summary>
          <p class="mt-3 text-base leading-relaxed text-slate-600">{item.answer}</p>
        </details>
      ))
    }
  </div>
</section>
